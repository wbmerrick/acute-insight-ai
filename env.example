# Application
VITE_APP_NAME=v8 App Template
VITE_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Server
NODE_ENV=development
PORT=3000

# Features
VITE_ENABLE_SOURCE_MAPPING=true
VITE_ENABLE_SSR=true

# Development Tools
VITE_SHOW_DEV_TOOLS=false
# Optional: same as app id — local Docker preview sets SITE_ID; with vite envPrefix SITE_, client can link to /develop/{id}
# SITE_ID=

# Database (Postgres)
# Either a full connection string (Supabase: use the transaction pooler URI):
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# ...or discrete variables:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=acute
# DB_PASS=<password>
# DB_NAME=acute_insight
# DB_SSL=disable   # local dev only; leave unset for managed hosts

# Auth
# BETTER_AUTH_SECRET=<openssl rand -hex 32>
# BETTER_AUTH_URL=https://your-domain.example
# BETTER_AUTH_TRUSTED_ORIGINS=https://acuteinsight.ai,https://www.acuteinsight.ai

# AI intake + provider briefs (Claude)
# With a key set, the intake chat becomes adaptive AI and provider briefs are
# LLM-generated. Without one, the app falls back to the scripted intake engine.
# PHI note: before real patient use, execute a BAA with your AI vendor.
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
# ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5-5

# GoDaddy Commerce (when skill-installed)
# Set by commerce-related skills when storefront features are added
# VITE_GODADDY_CLIENT_ID=<uuid-from-task-config>
# VITE_GODADDY_API_HOST=<hostname-from-GODADDY_API_BASE_URL>
# GODADDY_API_BASE_URL=https://api.dev-godaddy.com

# Authentication (when needed)
# JWT_SECRET=your-secret-here
# SESSION_SECRET=your-secret-here
